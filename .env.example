# Modèle de configuration — COPIE ce fichier en ".env" et remplis tes valeurs.
# Le fichier ".env" reste sur ta machine et n'est JAMAIS envoyé sur Git.
#
# 🔐 Ne mets ici QUE le jeton "Storefront API" (jeton public, conçu pour les apps).
#    Ne mets jamais ta clé Admin API ni un mot de passe.

# Domaine technique Shopify (PAS cash16.fr)
EXPO_PUBLIC_SHOPIFY_DOMAIN=cash16.myshopify.com

# Jeton d'accès Storefront API
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=colle_ton_jeton_storefront_ici

# Version de l'API (à laisser telle quelle en général)
EXPO_PUBLIC_SHOPIFY_API_VERSION=2025-04

# (Optionnel) URL de ton mini-serveur admin, une fois déployé (voir server/README.md).
# Sans cette valeur, l'écran "Espace admin" affiche un message de configuration.
# EXPO_PUBLIC_ADMIN_API_URL=https://cash16-admin-server.onrender.com

# Connexion Supabase (mêmes comptes que le site cash16.fr — clés publiques)
EXPO_PUBLIC_SUPABASE_URL=https://rsypkgoknrjqzjnitmqu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=colle_ta_cle_anon_supabase_ici
