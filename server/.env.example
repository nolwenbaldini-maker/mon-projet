# Configuration du mini-serveur admin — À DÉFINIR sur l'hébergeur (jamais commité).
#
# 🔐 Ces valeurs restent côté serveur. Ne les mets jamais dans l'app mobile.

# Domaine technique Shopify
SHOPIFY_STORE_DOMAIN=happycash16.myshopify.com

# Jeton d'accès Admin API (SECRET, tout-puissant) — voir le README
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Mot de passe que TOI seul connais : il protège l'espace admin de l'app
ADMIN_SECRET=choisis-un-mot-de-passe-solide

# Optionnels
SHOPIFY_API_VERSION=2025-04
PORT=3000
